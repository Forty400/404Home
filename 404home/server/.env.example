PORT=3001
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# C-end user JWT uses the same JWT_SECRET with claim role=user
# Domain/HTTPS optional until production cutover (IP access OK for now)

# UAT C-end account (seeded if missing; see docs/spdd/1-资产规范/404home-uat-guide.md)
UAT_USER_EMAIL=uat@404home.test
UAT_USER_PASSWORD=Uat404Home!

# LLM adapter (server-side only; ADR-20261109)
LLM_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_INPUT_USD_PER_MTOK=0.15
DEEPSEEK_OUTPUT_USD_PER_MTOK=0.6
# Second OpenAI-compatible provider (optional)
LLM_SECONDARY_API_KEY=
LLM_SECONDARY_BASE_URL=
LLM_SECONDARY_MODEL=
USD_CNY_RATE=7.2
BILLING_MARKUP=1.2
CHAT_MAX_HISTORY=20

# Embeddings（OpenAI 兼容，如硅基流动）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_STUB=0

# Smart search
SMART_SEARCH_RERANK=1
SMART_SEARCH_BILLING=0
SMART_SEARCH_RATE_LIMIT_PER_MIN=20
VECTOR_BACKEND=sqlite
RRF_K=60
RETRIEVE_K=20
RERANK_TOP_N=5
